<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.pietech.bundledelivery.ui.home.home.HomeFragment"
        android:label="Bundle Delivery"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_orderFragment"
            app:destination="@id/orderFragment" />
    </fragment>
    <fragment
        android:id="@+id/deliveriesFragment"
        android:name="com.pietech.bundledelivery.ui.home.deliveries.DeliveriesFragment"
        android:label="Deliveries"
        tools:layout="@layout/fragment_deliveries" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.pietech.bundledelivery.ui.home.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/orderFragment"
        android:name="com.pietech.bundledelivery.ui.home.order.OrderFragment"
        android:label="Order"
        tools:layout="@layout/fragment_order" />
</navigation>